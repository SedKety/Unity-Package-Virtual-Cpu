  tokens:
  - hex: 0x00
    color: {r: 0.85, g: 0.3, b: 0.3, a: 1}
    tooltip: "END \u2014 halt the CPU"
    argNames: []
  - hex: 0x01
    color: {r: 0.55, g: 0.55, b: 0.55, a: 1}
    tooltip: "NOP \u2014 no operation"
    argNames: []
  - hex: 0x02
    color: {r: 0.35, g: 0.7, b: 1, a: 1}
    tooltip: "CORECALL callIndex \u2014 invoke a built-in syscall"
